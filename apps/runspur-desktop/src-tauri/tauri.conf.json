{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runspur Desktop",
  "mainBinaryName": "runspur-desktop",
  "version": "0.1.4",
  "identifier": "dev.runspur.desktop",
  "build": {
    "beforeBuildCommand": "npm run ui:build && node scripts/stage-sidecars.mjs",
    "beforeDevCommand": "npm run ui:dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [{
      "title": "Runspur Desktop",
      "width": 960,
      "height": 670,
      "minWidth": 640,
      "minHeight": 520,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Runspur",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/schedulerd", "binaries/schedulerctl", "binaries/scheduler-mcp"]
  }
}
